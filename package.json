{
  "name": "erlc-organization",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "license": "LicenseRef-LBDT",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "bun scripts/site.mjs dev",
    "build": "bun scripts/site.mjs build",
    "preview": "bun --bun astro preview --host 0.0.0.0",
    "check": "bun scripts/site.mjs prepare && bun --bun astro check",
    "validate:docs": "bun scripts/validate-docs.mjs",
    "verify": "bun scripts/verify-site.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/starlight": "0.42.8",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/bun": "1.4.4",
    "typescript": "6"
  }
}
